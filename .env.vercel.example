# ═══════════════════════════════════════════════════════════════
# Vercel Environment Variables — add these in:
# Vercel Dashboard → Project → Settings → Environment Variables
# Set each for: Production, Preview, Development
# ═══════════════════════════════════════════════════════════════

# ── AI / LLM ─────────────────────────────────────────────────────
# Your Groq API key from console.groq.com (free tier available)
# The voice assistant, help page AI, and RAG all use this key.
# Both variable names are supported — set at least one.
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GEMINI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API URL ───────────────────────────────────────────────────────
# On Vercel, the backend is bundled in the same deployment.
# Leave this EMPTY so the frontend uses relative /api paths.
# DO NOT set this to a Railway or external URL.
VITE_API_URL=

# ── JWT Secret ────────────────────────────────────────────────────
# Strong random secret for signing JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Set this in Vercel as a SERVER-SIDE variable (no VITE_ prefix).
JWT_SECRET=replace_with_64_byte_hex_string
JWT_EXPIRES_IN=7d

# ── Rate Limiting ─────────────────────────────────────────────────
# Optional — defaults work fine if not set
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── ChromaDB ──────────────────────────────────────────────────────
# Only needed if you run a separate ChromaDB server.
# Leave unset on Vercel — BM25-only mode activates automatically.
# CHROMA_URL=https://your-chroma-server.railway.app

# ── CORS ──────────────────────────────────────────────────────────
# Additional allowed origins (comma-separated).
# Your *.vercel.app domains are allowed automatically.
# ALLOWED_ORIGINS=https://your-custom-domain.com

# ── Node Environment ──────────────────────────────────────────────
NODE_ENV=production
